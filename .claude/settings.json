{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/persona-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/observability/run-log.mjs\" \"PostToolUse:Bash\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/observability/run-log.mjs\" \"PreToolUse:Write\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(node validator/validate.mjs *)",
      "Bash(node eval/eval.mjs *)",
      "Bash(node dispatch/dispatch.mjs *)",
      "Bash(node observability/run-log.mjs *)",
      "Bash(node bin/agentcast.mjs *)"
    ]
  }
}
