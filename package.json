{
  "name": "agentcast",
  "version": "0.1.0",
  "description": "A library of reusable sub-agent personas, validated and scored.",
  "type": "module",
  "private": true,
  "author": "Naman Parikh (https://github.com/naman10parikh)",
  "repository": { "type": "git", "url": "git+https://github.com/naman10parikh/agentcast.git" },
  "homepage": "https://github.com/naman10parikh/agentcast#readme",
  "bin": {
    "agentcast": "./bin/agentcast.mjs",
    "agentcast-mcp": "./mcp/server.mjs"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node validator/validate.mjs --library",
    "eval": "node eval/eval.mjs --library && node eval/golden.mjs"
  },
  "files": ["bin/", "mcp/", "lib/", "validator/", "eval/", "dispatch/", "observability/run-log.mjs", "hooks/", "library/", "skills/", "identity/", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": ["ai", "claude", "agent", "sub-agents", "personas", "dev-tools", "agent-native", "mcp", "agent-skills", "claude-code"],
  "optionalDependencies": {
    "e2b": "^2.56.0"
  }
}
